{
  "imagesDir": "public/images",
  "mediaRoots": null,
  "indexPath": "data/vis.sqlite",
  "registryPath": "data/visual-registry.json",
  "atlasPath": "data/vis-atlas.json",
  "dashboardPath": "data/vis-dashboard.html",
  "brandDnaPath": "data/brand-visual-dna.json",
  "sitemapMapPath": "data/sitemap-image-map.json",
  "skipSuffixes": ["_thumb.jpeg", "_thumb.jpg", "_thumb.png"],
  "imageExtensions": [".png", ".jpg", ".jpeg", ".webp", ".gif", ".svg", ".avif"],
  "videoExtensions": [".mp4", ".webm", ".mov", ".m4v"],
  "audioExtensions": [".mp3", ".wav", ".m4a", ".flac", ".ogg"],
  "documentExtensions": [".md", ".mdx", ".txt", ".json", ".yaml", ".yml"],
  "maxFileSizeKB": 2000,
  "placeholderImages": ["blog-hero-aurora.svg", "placeholder.png", "default-hero.png"],
  "contentDirs": ["content", "app", "pages", "components", "data", "docs", "lib", "src"],
  "usageRoots": null,
  "eagleLibraries": [
    "%USERPROFILE%\\Google Drive\\Starlight Creative Vault\\01_Eagle_Library",
    "%USERPROFILE%\\My Drive\\Starlight Creative Vault\\01_Eagle_Library",
    "%USERPROFILE%\\OneDrive\\Starlight Creative Vault\\01_Eagle_Library"
  ],
  "scanProfiles": {
    "frank-estate": {
      "description": "Frank's local-first VIS estate: Starlight repos, Drive creative vault, Eagle library, mobile inbox, and Music IS proof folders.",
      "mediaRoots": [
        "%USERPROFILE%\\starlight\\repos",
        "%USERPROFILE%\\brands\\image-system",
        "%USERPROFILE%\\Google Drive\\Starlight Creative Vault",
        "%USERPROFILE%\\My Drive\\Starlight Creative Vault",
        "%USERPROFILE%\\OneDrive\\Starlight Creative Vault",
        "%USERPROFILE%\\starlight\\repos\\Starlight-Intelligence-System\\verticals\\music-is"
      ],
      "usageRoots": [
        "%USERPROFILE%\\starlight\\repos\\frankx.ai-vercel-website",
        "%USERPROFILE%\\starlight\\repos\\arcanea-ai-app",
        "%USERPROFILE%\\starlight\\repos\\Starlight-Intelligence-System"
      ],
      "allowedRoots": [
        "%USERPROFILE%\\starlight\\repos",
        "%USERPROFILE%\\brands\\image-system",
        "%USERPROFILE%\\Google Drive\\Starlight Creative Vault",
        "%USERPROFILE%\\My Drive\\Starlight Creative Vault",
        "%USERPROFILE%\\OneDrive\\Starlight Creative Vault"
      ],
      "notes": [
        "Run without --execute first; missing Drive/Eagle roots are expected until that software is installed.",
        "Music IS remains canonical for release state. VIS indexes and links music media assets.",
        "Use the MCP allowlist output when installing VIS on Claude/Codex on each laptop."
      ]
    }
  },
  "usageIncludeDirs": ["app", "pages", "components", "content", "docs", "lib", "src"],
  "maxUsageFileBytes": 524288,
  "privateDirPatterns": [
    ".git",
    "node_modules",
    ".next",
    ".turbo",
    ".vercel",
    "dist",
    "build",
    "coverage",
    "cache",
    ".cache",
    "tmp",
    ".worktrees",
    ".hermes-worktrees",
    ".claude",
    ".claude-worktrees",
    ".codex-artifacts",
    ".codex-remote-attachments",
    ".codex-scratch",
    ".codex-verify",
    ".codex-worktrees",
    "chrome-mobile-*",
    "Manifest Resources",
    "_originals",
    ".starlight",
    ".agent",
    ".machine",
    ".heart",
    ".env"
  ],
  "allowedRoots": null,
  "rightsDefault": "unknown",
  "approvalDefault": "candidate",
  "council": {
    "enabled": true,
    "perspectives": ["brand-guardian", "conversion-optimizer", "accessibility-auditor"]
  },
  "optimization": {
    "enabled": false,
    "formats": ["webp"],
    "sizes": [640, 1280, 1920],
    "quality": 85
  },
  "notifications": {
    "slack": null,
    "discord": null
  },
  "budgets": {
    "minScore": 50,
    "maxTotalSizeMB": 500,
    "maxPlaceholderCount": 0,
    "maxOversizedCount": 20,
    "minCoveragePercent": 30
  }
}
