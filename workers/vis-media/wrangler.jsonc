{
  // Private preview Worker for the VIS library. Not deployed.
  // Deploy only after Frank confirms the account and the R2 exception is on the Empire Registry.
  "name": "vis-media",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "workers_dev": false,
  "preview_urls": false,
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "starlight-media-private" }
  ],
  // Optional. Only needed for on-the-fly resize of a master without a stored rendition.
  // "images": { "binding": "IMAGES" },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true }
  }
  // Secrets (wrangler secret put): PREVIEW_SIGNING_KEY, ADMIN_TOKEN
}
