{
  "name": "visual-intelligence",
  "version": "0.2.0",
  "description": "Local-first Visual Intelligence OS for AI-native creators: asset graph, provenance, MCP, dashboard, and publication readiness.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "vis": "bin/vis.mjs"
  },
  "scripts": {
    "build": "node bin/vis.mjs --help",
    "dev": "node bin/vis.mjs dashboard",
    "test": "node --test tests/**/*.test.mjs",
    "lint": "node --check bin/vis.mjs && node --check core/vis-core.mjs && node --check core/dam-storage-policy.mjs && node --check mcp/vis-mcp-server.mjs && node --check web/vis-dashboard.mjs && node --check scripts/sync-github-tasks.mjs && node --check scripts/project-status.mjs && node --check scripts/plan-dam-rollout.mjs",
    "scan": "node bin/vis.mjs scan",
    "audit": "node bin/vis.mjs audit",
    "report": "node bin/vis.mjs report",
    "dashboard": "node bin/vis.mjs dashboard",
    "doctor": "node bin/vis.mjs doctor",
    "mcp": "node mcp/vis-mcp-server.mjs",
    "tasks:dry-run": "node scripts/sync-github-tasks.mjs",
    "tasks:sync": "node scripts/sync-github-tasks.mjs",
    "project:status": "node scripts/project-status.mjs",
    "project:report": "node scripts/project-status.mjs --write-report",
    "dam:plan": "node scripts/plan-dam-rollout.mjs"
  },
  "keywords": [
    "visual-assets",
    "image-management",
    "dam",
    "digital-asset-management",
    "ai-images",
    "image-audit",
    "brand-consistency",
    "visual-intelligence",
    "creator-tools",
    "agentic",
    "next-js",
    "vercel"
  ],
  "author": {
    "name": "Frank Riemer",
    "url": "https://frankx.ai"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/frankxai/visual-intelligence"
  },
  "homepage": "https://frankx.ai/products/visual-intelligence",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "optionalDependencies": {
    "sharp": "^0.33.0"
  },
  "files": [
    "bin/",
    "core/",
    "mcp/",
    "web/",
    "config/",
    "scripts/",
    "schemas/",
    "templates/",
    "docs/"
  ]
}
